---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { categories, formats } from "../data/library";
---
<Base title="Knowledge Library" description="A curated directory of knowledge categories and reputable offline sources — encyclopedias, health guides, engineering, agriculture, maps and more.">
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Knowledge library</p>
      <h1>Preserve knowledge before you need it.</h1>
      <p class="lead">
        A curated directory of what's worth keeping and where to find it. RTW helps you store and share these
        resources — it doesn't bundle or redistribute them.
      </p>
      <div class="grid grid-3 legend">
        <div class="note"><strong>Supported formats</strong><br />File types the RTW server can show today.</div>
        <div class="note"><strong>Recommended sources</strong><br />Reputable publishers. Download from them directly, under their terms.</div>
        <div class="note"><strong>Included in RTW</strong><br />No third-party content ships with RTW. Fetch commands download from the original source.</div>
      </div>
    </div>
  </section>

  <section class="section formats-sec" aria-labelledby="formats-h">
    <div class="container">
      <h2 id="formats-h" class="small-h">Supported formats</h2>
      <ul class="formats">
        {Object.entries(formats).map(([, f]) => (
          <li><span class="mono">{f.label}</span><span class="muted">{f.where}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="cats-h">
    <div class="container">
      <h2 id="cats-h" class="visually-hidden">Categories</h2>
      <nav class="cat-nav" aria-label="Categories">
        {categories.map((c) => <a href={`#${c.id}`}><Icon name={c.icon} size={15} /> {c.name}</a>)}
      </nav>
      <div class="cats">
        {categories.map((c, i) => (
          <article class="card cat" id={c.id} aria-labelledby={`${c.id}-h`}>
            <header>
              <span class="icon-tile"><Icon name={c.icon} /></span>
              <span class="mono num">{String(i + 1).padStart(2, "0")}</span>
            </header>
            <h3 id={`${c.id}-h`}>{c.name}</h3>
            <p>{c.description}</p>

            <h4>Useful content</h4>
            <ul class="examples">{c.examples.map((e) => <li>{e}</li>)}</ul>

            <h4>Resource types</h4>
            <ul class="tags">{c.formats.map((f) => <li class="mono">{formats[f].label}</li>)}</ul>

            <h4>Recommended sources</h4>
            <ul class="providers">
              {c.providers.map((p) => (
                <li>
                  <a href={p.url}>{p.name}{p.url.startsWith("http") && <Icon name="external" size={12} />}</a>
                  <span>{p.note}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="packs-h">
    <div class="container narrow">
      <span class="badge badge-planned">Planned</span>
      <h2 id="packs-h">Knowledge packs</h2>
      <p class="lead">
        A future goal is curated packs — a category's essential resources, checked for licensing, ready to load in one step.
        They don't exist yet. Until then, this directory points you to the sources.
      </p>
      <p class="muted">
        Know a resource that belongs here? <a href="/contribute/">Suggest it</a>. Health and safety material is listed for reference and education;
        it hasn't been reviewed by professionals for RTW and doesn't replace qualified advice or emergency services.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-bottom: 40px; }
  .page-hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: 18ch; }
  .page-hero .lead { max-width: 62ch; }
  .legend { margin-top: 32px; }
  .legend .note { font-size: .9rem; }
  .formats-sec { padding: 40px 0; }
  .small-h { font-size: .78rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--subtle); font-weight: 500; }
  .formats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .formats li { display: grid; padding: 10px 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); font-size: .85rem; }
  .formats .mono { color: var(--accent); }
  .cat-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .cat-nav a { display: inline-flex; align-items: center; gap: 6px; font-size: .82rem; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; text-decoration: none; color: var(--muted); }
  .cat-nav a:hover { color: var(--text); border-color: var(--border-strong); }
  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .cat { display: flex; flex-direction: column; scroll-margin-top: calc(var(--header-h) + 16px); }
  .cat header { display: flex; justify-content: space-between; }
  .num { color: var(--subtle); font-size: .8rem; }
  .cat h3 { font-size: 1.25rem; }
  h4 { font-size: .7rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--subtle); font-weight: 500; margin: 20px 0 8px; }
  .examples { margin: 0; padding-left: 1.1em; color: var(--muted); font-size: .9rem; display: grid; gap: 2px; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-size: .72rem; padding: 2px 8px; border-radius: 6px; background: var(--elevated); border: 1px solid var(--border); }
  .providers { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: .88rem; }
  .providers li { display: grid; gap: 2px; }
  .providers a { color: var(--text); font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
  .providers span { color: var(--muted); }
  .narrow { max-width: 760px; }
  .narrow h2 { margin-top: 14px; }
  .narrow a { color: var(--accent); }
</style>
