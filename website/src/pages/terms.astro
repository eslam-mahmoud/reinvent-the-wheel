---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
const updated = new Date(site.legalUpdated).toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" });
---
<Base title="Terms" description="Terms for using this website and the information on it.">
  <section class="section">
    <div class="container prose">
      <h1>Terms</h1>
      <p class="muted">Last updated {updated}</p>

      <h2>The website</h2>
      <p>
        This website describes the Reinvent the Wheel open-source project. It's provided as is, without warranties of any kind. We try to keep it accurate,
        but things change — check the documentation and repository for the current state.
      </p>

      <h2>The software</h2>
      <p>
        {site.license
          ? <>The RTW software is released under the <a href={site.license.url}>{site.license.name} license</a>, which governs its use.</>
          : <>The RTW source code is public. A license file has not been published in the repository yet; until it is, check the repository before reusing the code.</>}
        {" "}It is provided as is, without warranty.
      </p>

      <h2>Third-party content</h2>
      <p>
        RTW helps you store and share material from other publishers — Wikipedia, Kiwix, map data, books and more. That material belongs to its
        publishers and is covered by their licenses and terms. Not everything that's free to download is free to redistribute. You're responsible for
        respecting those terms when you share content with others.
      </p>

      <h2>Not professional advice</h2>
      <p>
        Health, safety, engineering and survival resources listed on this site are for reference and education. They haven't been professionally reviewed
        for RTW and don't replace qualified professionals or emergency services.
      </p>

      <h2>Changes</h2>
      <p>These terms may be updated; the date above shows the latest revision.</p>
    </div>
  </section>
</Base>
