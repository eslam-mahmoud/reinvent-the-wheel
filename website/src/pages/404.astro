---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
// One 404 page serves every URL, so it speaks both languages.
---
<Base title="Page not found · الصفحة غير موجودة" description="This page doesn't exist." noindex translated={false}>
  <section class="section nf">
    <div class="container grid grid-2">
      <div lang="en" dir="ltr">
        <p class="eyebrow mono">404</p>
        <h1>This page isn't in the library.</h1>
        <p class="lead">It may have moved, or the link may be mistyped.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/en/">Home <Icon name="arrow" size={16} /></a>
          <a class="btn" href="/en/docs/">Documentation</a>
        </div>
      </div>
      <div lang="ar" dir="rtl">
        <p class="eyebrow">404</p>
        <h1>هذه الصفحة ليست في المكتبة.</h1>
        <p class="lead">ربما نُقلت، أو أن الرابط مكتوب بشكل خاطئ.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/">الرئيسية</a>
          <a class="btn" href="/docs/">التوثيق</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 60vh; display: grid; align-items: center; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
  [dir="rtl"] h1, [dir="rtl"] p { letter-spacing: 0; }
</style>
