---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LibraryMockup from "../components/LibraryMockup.astro";
import NetworkDiagram from "../components/NetworkDiagram.astro";
import PlatformCard from "../components/PlatformCard.astro";
import { platforms } from "../data/platforms";
import { site } from "../config/site";

const problems = [
  { icon: "cap", title: "Learning stops", text: "Courses, textbooks and reference sites stop working the moment a connection drops." },
  { icon: "gear", title: "Repairs stall", text: "Repair guides and manuals increasingly live only online — out of reach exactly when something breaks." },
  { icon: "docs", title: "Manuals go missing", text: "Technical documentation moves, gets paywalled, or disappears when a company or website does." },
  { icon: "people", title: "Sharing gets hard", text: "Without connectivity, getting the same information to a group of people is slow and unreliable." },
];

const pillars = [
  { n: "01", icon: "archive", title: "Preserve knowledge", text: "Keep local copies of encyclopedias, books, maps and manuals on a device you control. Nothing depends on a remote server staying online." },
  { n: "02", icon: "offline", title: "Access it offline", text: "Read everything in an ordinary web browser, with no internet connection. Search Wikipedia, open books, browse maps." },
  { n: "03", icon: "share", title: "Share it locally", text: "Nearby phones, laptops and tablets connect over local Wi-Fi and read the same library — no app to install." },
];

const steps = [
  { n: "1", title: "Choose your device", text: "A Mac, or a 64-bit Android phone or tablet with Termux. Readers only need a web browser — older phones work fine for that." },
  { n: "2", title: "Prepare your library", text: "While you're online, download the collections you want — Wikipedia, maps, books, manuals — and organise them into sections." },
  { n: "3", title: "Go offline", text: "Start the library. Use it on the device itself, or turn on a hotspot so others nearby can read it too." },
];

const uses = [
  { icon: "school", title: "Offline education", text: "Reference material for classrooms with limited or expensive connectivity." },
  { icon: "mountain", title: "Remote communities", text: "A shared local library where the network is slow, costly or absent." },
  { icon: "archive", title: "Personal archives", text: "Your own copy of the material you rely on, under your control." },
  { icon: "bolt", title: "Infrastructure disruptions", text: "Outages happen. Useful information shouldn't go down with the network." },
  { icon: "compass", title: "Off-grid & travel", text: "Maps, guides and encyclopedias that work in the field, on a single device." },
  { icon: "wifi", title: "Local knowledge sharing", text: "One device serves a room — a workshop, a clinic, a community hall." },
];

const contrib = ["Code", "Documentation", "Testing", "Translations", "Collection recommendations", "Hardware compatibility reports"];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    alternateName: site.shortName,
    url: site.url,
    description: site.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: site.name,
    alternateName: site.shortName,
    description: site.description,
    url: site.url,
    ...(site.repo.url ? { codeRepository: site.repo.url } : {}),
    programmingLanguage: ["Shell", "Python", "JavaScript"],
    runtimePlatform: ["macOS", "Android (Termux)"],
    author: { "@type": "Person", name: site.maintainer.name, ...(site.maintainer.url ? { url: site.maintainer.url } : {}) },
  },
];
---
<Base jsonLd={jsonLd}>
  <!-- A. Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">
          <span>Open Source</span><span aria-hidden="true">·</span><span>Offline First</span><span aria-hidden="true">·</span><span>macOS &amp; Android</span>
        </p>
        <h1 class="reveal reveal-2">Civilization,<br /><span class="accent">Offline.</span></h1>
        <p class="hero-q reveal reveal-3">What if the internet disappeared tomorrow?</p>
        <p class="lead reveal reveal-3">
          Preserve, access, and share human knowledge using the devices you already own.
          No cloud dependency. No internet required to access downloaded content.
        </p>
        <div class="btn-row reveal reveal-4">
          <a class="btn btn-primary" href="/docs/quick-start/">Get Started <Icon name="arrow" size={16} /></a>
          {site.repo.url && <a class="btn" href={site.repo.url}><Icon name="github" size={18} /> View on GitHub</a>}
        </div>
        <ul class="platform-pills reveal reveal-4" aria-label="Supported platforms">
          <li><Icon name="apple" size={16} /> macOS</li>
          <li><Icon name="android" size={16} /> Android <span class="muted">· in testing</span></li>
        </ul>
      </div>
      <!-- B. Product visualization -->
      <div class="hero-visual reveal reveal-3">
        <LibraryMockup />
      </div>
    </div>
  </section>

  <!-- C. Problem -->
  <section class="section" aria-labelledby="problem-h">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-h">The internet is a remarkable invention. It's also a dependency.</h2>
        <p class="lead">
          Most of what we know how to do now lives on remote servers, reached through networks we don't control.
          That works — until it doesn't.
        </p>
        <p class="muted">
          Keeping local copies of essential information is a simple, old idea: libraries have done it for
          centuries. The internet shouldn't be the only place knowledge lives.
        </p>
      </div>
      <div class="grid grid-2 problems">
        {problems.map((p) => (
          <div class="card">
            <span class="icon-tile"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- D. Solution -->
  <section class="section" aria-labelledby="solution-h">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">The approach</p>
        <h2 id="solution-h">Keep what matters. Access it anywhere.</h2>
        <p class="lead">Your library. Your device. No internet required.</p>
      </div>
      <div class="grid grid-3">
        {pillars.map((p) => (
          <div class="card pillar hoverable">
            <div class="pillar-top"><span class="icon-tile"><Icon name={p.icon} /></span><span class="mono num">{p.n}</span></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- E. How it works -->
  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">Three steps. Then no connection needed.</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n mono">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="diagram-wrap">
        <NetworkDiagram />
      </div>
      <p><a class="text-link" href="/how-it-works/">Read the full explanation <Icon name="arrow" size={15} /></a></p>
    </div>
  </section>

  <!-- F. Platforms -->
  <section class="section" aria-labelledby="platforms-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Supported platforms</p>
        <h2 id="platforms-h">Start with what you have.</h2>
        <p class="lead">
          Both platforms run the same open-source server. They're not at the same stage — here's exactly what works today.
        </p>
      </div>
      <div class="grid grid-2">
        {platforms.map((p) => <PlatformCard platform={p} />)}
      </div>
    </div>
  </section>

  <!-- G. Use cases -->
  <section class="section" aria-labelledby="uses-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Use cases</p>
        <h2 id="uses-h">Built for more than emergencies.</h2>
        <p class="lead">An old phone can still be useful. So can a library that never needs a signal.</p>
      </div>
      <div class="grid grid-3">
        {uses.map((u) => (
          <div class="use">
            <span class="icon-tile"><Icon name={u.icon} /></span>
            <div>
              <h3>{u.title}</h3>
              <p>{u.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- H. Open source -->
  <section class="section" aria-labelledby="oss-h">
    <div class="container oss">
      <div>
        <p class="eyebrow">Open source</p>
        <h2 id="oss-h">Knowledge should be accessible. So should the tools that preserve it.</h2>
        <p class="lead">
          RTW is community-driven and built in the open. It stands on proven projects — Kiwix, OpenStreetMap,
          nginx — instead of reinventing them, and it's meant to be extended.
        </p>
        <div class="btn-row">
          {site.repo.url && <a class="btn btn-primary" href={site.repo.url}><Icon name="github" size={18} /> Contribute on GitHub</a>}
          <a class="btn" href="/contribute/">Ways to help</a>
        </div>
      </div>
      <ul class="contrib" aria-label="Ways to contribute">
        {contrib.map((c) => <li><Icon name="check" size={16} /> {c}</li>)}
      </ul>
    </div>
  </section>

  <!-- I. Closing CTA -->
  <section class="section closing" aria-labelledby="close-h">
    <div class="container center">
      <svg class="close-mark" width="56" height="56" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16 3.5A12.5 12.5 0 0 1 26.83 9.75" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round"/><path d="M16 12.6V5.6M16 19.4v7M19.4 16h7M12.6 16h-7M18.4 13.6l4.95-4.95M13.6 18.4l-4.95 4.95M18.4 18.4l4.95 4.95M13.6 13.6l-4.95-4.95" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="16" cy="16" r="3.4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <h2 id="close-h">Keep knowledge alive.</h2>
      <p class="lead">Build your offline library today. Make it available when it matters.</p>
      <div class="btn-row center-row">
        <a class="btn btn-primary" href="/docs/quick-start/">Get Started <Icon name="arrow" size={16} /></a>
        <a class="btn" href="/how-it-works/">Explore the Project</a>
      </div>
      <p class="closing-line mono">Preserve what we know · Share what we've learned · Keep knowledge alive</p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 30%, #000 30%, transparent 75%);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  h1 { margin-bottom: 20px; }
  .accent { color: var(--accent); }
  .hero-q { font-size: clamp(1.15rem, 2vw, 1.4rem); font-weight: 600; margin-bottom: 10px; }
  .hero-copy .lead { max-width: 34em; margin-bottom: 28px; }
  .platform-pills { list-style: none; padding: 0; margin: 26px 0 0; display: flex; gap: 10px; flex-wrap: wrap; }
  .platform-pills li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; font-size: .85rem; background: var(--surface); }

  .split { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .split .section-head { margin-bottom: 0; position: sticky; top: calc(var(--header-h) + 32px); }
  .problems { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }

  .pillar-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .num { color: var(--subtle); font-size: .8rem; }

  .steps { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s; }
  .steps li { padding: 24px; border-top: 2px solid var(--border); position: relative; }
  .steps li:first-child { border-top-color: var(--accent); }
  .step-n { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--accent); color: var(--accent); font-size: .85rem; margin-bottom: 14px; }
  .steps p { color: var(--muted); margin: 0; font-size: .95rem; }
  .diagram-wrap { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(14px, 3vw, 28px); background: var(--surface); margin-bottom: 20px; }
  .text-link { color: var(--accent); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .text-link:hover { text-decoration: underline; }

  .use { display: flex; gap: 16px; padding: 8px 0; }
  .use .icon-tile { flex: none; margin: 0; }
  .use h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .use p { color: var(--muted); margin: 0; font-size: .95rem; }

  .oss { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: center; }
  .oss .lead { margin-bottom: 28px; }
  .contrib { list-style: none; margin: 0; padding: 8px; display: grid; gap: 2px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .contrib li { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 10px; }
  .contrib li:not(:last-child) { border-bottom: 1px solid var(--border); border-radius: 0; }
  .contrib :global(svg) { color: var(--accent); }

  .closing { text-align: center; }
  .center { text-align: center; }
  .close-mark { color: var(--muted); margin-bottom: 20px; }
  .closing h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .center-row { justify-content: center; margin-top: 28px; }
  .closing-line { margin-top: 40px; font-size: .78rem; color: var(--subtle); letter-spacing: .04em; }
  @media (prefers-reduced-motion: no-preference) {
    .close-mark { transition: transform 1.4s cubic-bezier(.2, .7, .2, 1); }
    .closing:hover .close-mark { transform: rotate(90deg); }
  }

  @media (max-width: 980px) {
    .hero-grid, .split, .oss { grid-template-columns: minmax(0, 1fr); }
    .split .section-head { position: static; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
