---
// The RTW wheel: rim, hub, eight spokes, and a brass arc on the rim — a
// single turn of the wheel, the cycle of learning and rebuilding.
// Same geometry as public/favicon.svg.
interface Props {
  size?: number;
  wordmark?: boolean;
}
import { site } from "../config/site";
import { langFromPath } from "../i18n/config";
const { size = 28, wordmark = true } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---
<span class="logo">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="2.4" />
    <path d="M16 3.5 A12.5 12.5 0 0 1 26.83 9.75" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" />
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M16 12.6V5.6M16 19.4v7M19.4 16h7M12.6 16h-7M18.4 13.6l4.95-4.95M13.6 18.4l-4.95 4.95M18.4 18.4l4.95 4.95M13.6 13.6l-4.95-4.95" />
    </g>
    <circle cx="16" cy="16" r="3.4" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="16" cy="16" r="1" fill="var(--accent)" />
  </svg>
  {wordmark && (
    <span class="logo-word">{site.name[lang]}</span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--text); }
  .logo-mark { flex: none; transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .logo-word { font-weight: 650; letter-spacing: -0.015em; font-size: 1rem; white-space: nowrap; }
  :global(a:hover) > .logo .logo-mark,
  :global(a:focus-visible) > .logo .logo-mark { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) {
    .logo-mark { transition: none; }
  }
</style>
