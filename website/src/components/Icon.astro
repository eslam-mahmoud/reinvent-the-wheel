const body = paths[name];
// Arrows follow the reading direction; flipped in right-to-left pages.
const flip = name === "arrow" || name === "external";
if (!body) throw new Error(`Unknown icon: ${name}`);
---
<svg
  class:list={[cls, { "flip-rtl": flip }]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={body}
/>
