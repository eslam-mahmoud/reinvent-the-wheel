---
import Icon from "./Icon.astro";
import type { Platform } from "../data/platforms";
import { href, type Lang } from "../i18n/config";
import { t } from "../i18n/ui";
interface Props { platform: Platform; lang: Lang }
const { platform: p, lang } = Astro.props;
const s = t(lang);
---
<article class="card platform">
  <header>
    <span class="icon-tile"><Icon name={p.id === "macos" ? "apple" : "android"} /></span>
    <span class={`badge badge-${p.status}`}>{p.statusText[lang]}</span>
  </header>
  <h3>{p.name}</h3>
  <p>{p.summary[lang]}</p>

  <ul class="caps">
    {p.capabilities.map((c) => (
      <li>
        <span class={`badge badge-${c.status}`}>{s.status[c.status]}</span>
        <span>{c.label[lang]}{c.note && <span class="note-inline"> — {c.note[lang]}</span>}</span>
      </li>
    ))}
  </ul>

  <div class="btn-row">
    <a class="btn" href={href(`/download/#${p.id}`, lang)}>
      {s.setup(p.name)} <Icon name="arrow" size={16} />
    </a>
  </div>
</article>

<style>
  .platform { display: flex; flex-direction: column; gap: 4px; }
  header { display: flex; justify-content: space-between; align-items: flex-start; }
  h3 { font-size: 1.4rem; margin-top: 4px; }
  .caps { list-style: none; padding: 0; margin: 18px 0 22px; display: grid; gap: 10px; font-size: .9rem; color: var(--muted); }
  .caps li { display: grid; grid-template-columns: 104px 1fr; gap: 12px; align-items: start; }
  .caps .badge { justify-self: start; align-self: start; font-size: .64rem; padding: 2px 8px; }
  .note-inline { color: var(--subtle); }
  .btn-row { margin-top: auto; }
</style>
