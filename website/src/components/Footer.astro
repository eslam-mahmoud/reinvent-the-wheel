---
import Logo from "./Logo.astro";
import { site } from "../config/site";
import { href, type Lang } from "../i18n/config";
import { t } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const f = s.footer;
const h = (p: string) => href(p, lang);

const year = new Date().getFullYear();
const cols = [
  {
    title: f.project,
    links: [
      { href: h("/how-it-works/"), label: s.nav.how },
      { href: h("/library/"), label: f.knowledgeLibrary },
      { href: h("/about/"), label: s.nav.about },
      { href: h("/about/#roadmap"), label: f.roadmap },
    ],
  },
  {
    title: f.platforms,
    links: [
      { href: h("/download/#macos"), label: "macOS" },
      { href: h("/download/#android"), label: "Android" },
      { href: h("/docs/quick-start/"), label: f.quickStart },
    ],
  },
  {
    title: f.resources,
    links: [
      { href: h("/docs/"), label: f.documentation },
      { href: h("/contribute/"), label: s.nav.contribute },
      ...(site.repo.url ? [{ href: site.repo.url, label: "GitHub" }] : []),
      { href: h("/about/#acknowledgments"), label: f.acknowledgments },
    ],
  },
  {
    title: f.legal,
    links: [
      { href: h("/privacy/"), label: f.privacy },
      { href: h("/terms/"), label: f.terms },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand-col">
        <a href={h("/")} class="brand" aria-label={`${site.name} — ${s.home}`}><Logo /></a>
        <p class="tag">{site.tagline[lang]}<br /><span>{site.statement[lang]}</span></p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>
        © {year} {site.maintainer.url ? <a href={site.maintainer.url}>{site.maintainer.name}</a> : site.maintainer.name} {f.rights}
        {site.license ? <a href={site.license.url}>{f.licensed(site.license.name)}</a> : f.unlicensed}
      </p>
      <p class="mono built">{f.builtOn}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 56px 0 32px; font-size: .92rem; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 32px; }
  .brand { text-decoration: none; display: inline-flex; }
  .tag { margin-top: 14px; color: var(--text); font-weight: 500; }
  .tag span { color: var(--muted); font-weight: 400; }
  h2 { font-size: .75rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--subtle); font-weight: 500; margin-bottom: 14px; }
  :global([dir="rtl"]) h2 { font-family: var(--font-sans); letter-spacing: 0; font-size: .82rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--text); }
  .bottom { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: var(--subtle); }
  .bottom p { margin: 0; }
  .bottom a { color: var(--muted); text-decoration: underline; }
  .built { font-size: .78rem; }
  :global([dir="rtl"]) .built { font-family: var(--font-sans); }
  @media (max-width: 860px) {
    .top { grid-template-columns: repeat(2, 1fr); }
    .brand-col { grid-column: 1 / -1; }
  }
</style>
