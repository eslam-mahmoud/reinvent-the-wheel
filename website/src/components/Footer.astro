---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
const cols = [
  {
    title: "Project",
    links: [
      { href: "/how-it-works/", label: "How It Works" },
      { href: "/library/", label: "Knowledge Library" },
      { href: "/about/", label: "About" },
      { href: "/about/#roadmap", label: "Roadmap" },
    ],
  },
  {
    title: "Platforms",
    links: [
      { href: "/download/#macos", label: "macOS" },
      { href: "/download/#android", label: "Android" },
      { href: "/docs/quick-start/", label: "Quick Start" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/docs/", label: "Documentation" },
      { href: "/contribute/", label: "Contribute" },
      ...(site.repo.url ? [{ href: site.repo.url, label: "GitHub" }] : []),
      { href: "/about/#acknowledgments", label: "Acknowledgments" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy/", label: "Privacy" },
      { href: "/terms/", label: "Terms" },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand-col">
        <a href="/" class="brand" aria-label={`${site.name} — home`}><Logo /></a>
        <p class="tag">{site.tagline}<br /><span>{site.statement}</span></p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>
        © {year} {site.maintainer.url ? <a href={site.maintainer.url}>{site.maintainer.name}</a> : site.maintainer.name} and contributors.
        {site.license ? <> Released under the <a href={site.license.url}>{site.license.name} license</a>.</> : " Open source; license to be published in the repository."}
      </p>
      <p class="mono">Built on Kiwix, OpenStreetMap, Protomaps, nginx and MapLibre.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 56px 0 32px; margin-top: 0; font-size: .92rem; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 32px; }
  .brand { text-decoration: none; display: inline-flex; }
  .tag { margin-top: 14px; color: var(--text); font-weight: 500; }
  .tag span { color: var(--muted); font-weight: 400; }
  h2 { font-size: .75rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .08em; color: var(--subtle); font-weight: 500; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { color: var(--text); }
  .bottom { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: var(--subtle); }
  .bottom p { margin: 0; }
  .bottom a { color: var(--muted); text-decoration: underline; }
  .bottom .mono { font-size: .78rem; }
  @media (max-width: 860px) {
    .top { grid-template-columns: repeat(2, 1fr); }
    .brand-col { grid-column: 1 / -1; }
  }
</style>
