---
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import { getDocs, docUrl } from "../data/docs";
import { repoLink } from "../config/site";

interface Props {
  title: string;
  description: string;
  id?: string;
  draft?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, id, draft = false, headings = [] } = Astro.props;
const docs = await getDocs();
const index = id ? docs.findIndex((d) => d.id === id) : -1;
const prev = index > 0 ? docs[index - 1] : null;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : null;
const toc = headings.filter((h) => h.depth === 2);
const editUrl = id ? repoLink(`/edit/main/website/src/content/docs/${id}.md`) : null;
const path = Astro.url.pathname;
---
<Base title={title} description={description}>
  <div class="container docs">
    <aside class="sidebar" aria-label="Documentation">
      <div class="search">
        <label for="doc-search" class="visually-hidden">Search documentation</label>
        <Icon name="search" size={16} />
        <input id="doc-search" type="search" placeholder="Search docs" autocomplete="off" data-search />
      </div>
      <ul class="search-results" data-results hidden></ul>
      <nav data-docnav>
        <ul>
          <li><a href="/docs/" aria-current={path === "/docs/" ? "page" : undefined}>Overview</a></li>
          {docs.map((d) => (
            <li>
              <a href={docUrl(d.id)} aria-current={d.id === id ? "page" : undefined}>
                {d.data.title}
                {d.data.draft && <span class="tag">draft</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <article class="content">
      {draft && (
        <p class="note draft-note"><strong>Work in progress.</strong> This page records what's known so far and needs maintainer input before it's complete.</p>
      )}
      <div class="prose">
        <slot />
      </div>

      <footer class="doc-foot">
        {editUrl && (
          <a class="edit" href={editUrl}>Edit this page on GitHub <Icon name="external" size={14} /></a>
        )}
        <nav class="pager" aria-label="Previous and next pages">
          {prev ? <a href={docUrl(prev.id)} class="card"><span class="mono">Previous</span>{prev.data.title}</a> : <span />}
          {next && <a href={docUrl(next.id)} class="card next"><span class="mono">Next</span>{next.data.title}</a>}
        </nav>
      </footer>
    </article>

    {toc.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <p class="mono">On this page</p>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>
</Base>

<script>
  // Tiny client-side search over a build-time index (fetched on first use).
  type Doc = { title: string; description: string; url: string; text: string };
  const input = document.querySelector<HTMLInputElement>("[data-search]");
  const results = document.querySelector<HTMLUListElement>("[data-results]");
  const nav = document.querySelector<HTMLElement>("[data-docnav]");
  let index: Doc[] | null = null;

  const load = async () => (index ??= await fetch("/docs/search.json").then((r) => r.json()));

  input?.addEventListener("focus", load, { once: true });
  input?.addEventListener("input", async () => {
    const q = input.value.trim().toLowerCase();
    if (!results || !nav) return;
    if (!q) { results.hidden = true; nav.hidden = false; return; }
    const docs = await load();
    const terms = q.split(/\s+/);
    const hits = docs
      .map((d) => {
        const hay = (d.title + " " + d.description + " " + d.text).toLowerCase();
        if (!terms.every((t) => hay.includes(t))) return null;
        const score = terms.reduce((s, t) => s + (d.title.toLowerCase().includes(t) ? 10 : 0) + (d.description.toLowerCase().includes(t) ? 3 : 0), 0);
        return { d, score };
      })
      .filter((x): x is { d: Doc; score: number } => !!x)
      .sort((a, b) => b.score - a.score);
    results.replaceChildren(
      ...(hits.length
        ? hits.map(({ d }) => {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = d.url;
            a.innerHTML = "";
            a.append(Object.assign(document.createElement("strong"), { textContent: d.title }), Object.assign(document.createElement("span"), { textContent: d.description }));
            li.append(a);
            return li;
          })
        : [Object.assign(document.createElement("li"), { className: "none", textContent: "No matches" })])
    );
    results.hidden = false;
    nav.hidden = true;
  });
</script>

<style>
  .docs { display: grid; grid-template-columns: 240px minmax(0, 1fr) 200px; gap: 48px; padding-top: 40px; padding-bottom: 80px; align-items: start; }
  .sidebar, .toc { position: sticky; top: calc(var(--header-h) + 24px); max-height: calc(100vh - var(--header-h) - 48px); overflow-y: auto; }
  .search { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 10px; padding: 0 10px; background: var(--surface); color: var(--subtle); margin-bottom: 16px; }
  .search input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--text); font: inherit; font-size: .9rem; height: 40px; outline: none; }
  .search:focus-within { border-color: var(--accent); }
  .sidebar ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .sidebar nav a, .search-results a {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 10px; border-radius: 8px;
    color: var(--muted); text-decoration: none; font-size: .9rem;
  }
  .sidebar nav a:hover { color: var(--text); background: var(--surface); }
  .sidebar nav a[aria-current="page"] { color: var(--text); background: var(--surface); box-shadow: inset 2px 0 0 var(--accent); }
  .tag { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; color: var(--warn); border: 1px solid currentColor; border-radius: 999px; padding: 0 6px; }
  .search-results a { display: grid; gap: 2px; }
  .search-results a strong { color: var(--text); font-weight: 600; }
  .search-results a span { font-size: .8rem; }
  .search-results a:hover { background: var(--surface); }
  .search-results .none { color: var(--subtle); font-size: .9rem; padding: 7px 10px; }

  .draft-note { margin-bottom: 24px; }
  .doc-foot { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); display: grid; gap: 24px; max-width: 72ch; }
  .edit { color: var(--muted); font-size: .88rem; display: inline-flex; align-items: center; gap: 6px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pager .card { display: grid; gap: 2px; padding: 14px 18px; font-weight: 600; text-decoration: none; }
  .pager .card .mono { font-size: .72rem; color: var(--subtle); font-weight: 400; }
  .pager .next { text-align: right; grid-column: 2; }

  .toc p { font-size: .72rem; color: var(--subtle); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
  .toc a { display: block; padding: 4px 0; color: var(--muted); text-decoration: none; font-size: .85rem; }
  .toc a:hover { color: var(--text); }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: 220px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 860px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 24px; }
    .sidebar { position: static; max-height: none; border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }
    .sidebar nav ul { display: grid; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .sidebar nav ul { grid-template-columns: 1fr; }
  }
</style>
