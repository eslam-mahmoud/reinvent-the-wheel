---
import Base from "../layouts/Base.astro";
import { site, issuesUrl } from "../config/site";
import { type Lang } from "../i18n/config";

interface Props { lang: Lang }
const { lang } = Astro.props;
const updated = new Date(site.legalUpdated).toLocaleDateString(lang === "ar" ? "ar" : "en", { year: "numeric", month: "long", day: "numeric" });
const issues = issuesUrl ?? site.repo.url ?? "";
const c = {
  en: {
    title: "Privacy", description: "What this website does and doesn't collect.", updated: `Last updated ${updated}`,
    html: `
<h2>This website</h2>
<p>reinvent-the-wheel.com is a static website. It has no accounts, no forms, and no comments.</p>
<ul>
<li><strong>No cookies</strong> are set by this website.</li>
<li><strong>No analytics or tracking scripts</strong> are used.</li>
<li><strong>No third-party requests:</strong> fonts, scripts and images are served from this domain.</li>
<li><strong>Theme preference:</strong> if you switch between light and dark, your choice is saved in your browser's local storage on your device. It's never sent anywhere. Clearing your site data removes it.</li>
</ul>
<h2>Hosting</h2>
<p>The site is hosted on <a href="https://www.cloudflare.com/">Cloudflare</a>. Like any web host, Cloudflare processes technical request data — such as IP addresses, browser information and requested pages — to deliver and protect the site. See <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a>. The project doesn't add analytics on top of that.</p>
<h2>Links to other sites</h2>
<p>Links to GitHub, content publishers and other projects take you to sites with their own privacy practices.</p>
<h2>The RTW software</h2>
<p>This page covers the website only. The RTW software runs on your own devices and contains no telemetry. It connects to the internet only when you ask it to — installing (package managers, GitHub, Kiwix, the npm registry) and fetching content from the publishers listed in the documentation. Readers who use your library talk only to your device.</p>
<h2>Questions</h2>
<p>Open an issue on <a href="${issues}">GitHub</a>.</p>`,
  },
  ar: {
    title: "الخصوصية", description: "ما الذي يجمعه هذا الموقع وما الذي لا يجمعه.", updated: `آخر تحديث: ${updated}`,
    html: `
<h2>هذا الموقع</h2>
<p>reinvent-the-wheel.com موقع ثابت، بلا حسابات ولا نماذج ولا تعليقات.</p>
<ul>
<li><strong>لا ملفات تعريف ارتباط (cookies)</strong> يضعها هذا الموقع.</li>
<li><strong>لا أدوات تحليل أو تتبّع</strong> مستخدمة.</li>
<li><strong>لا طلبات إلى أطراف أخرى:</strong> الخطوط والسكربتات والصور تُقدَّم من هذا النطاق.</li>
<li><strong>تفضيل المظهر:</strong> إن بدّلت بين الوضعين الفاتح والداكن، يُحفظ اختيارك في التخزين المحلي لمتصفحك على جهازك، ولا يُرسل إلى أي مكان. يُحذف بمسح بيانات الموقع.</li>
</ul>
<h2>الاستضافة</h2>
<p>الموقع مستضاف على <a href="https://www.cloudflare.com/">Cloudflare</a>. وككل مستضيف ويب، تعالج Cloudflare بيانات تقنية عن الطلبات — مثل عناوين IP ومعلومات المتصفح والصفحات المطلوبة — لتقديم الموقع وحمايته. راجع <a href="https://www.cloudflare.com/privacypolicy/">سياسة الخصوصية لدى Cloudflare</a>. لا يضيف المشروع أي أدوات تحليل فوق ذلك.</p>
<h2>الروابط إلى مواقع أخرى</h2>
<p>الروابط إلى GitHub والناشرين والمشاريع الأخرى تنقلك إلى مواقع لها ممارسات خصوصية خاصة بها.</p>
<h2>برنامج RTW</h2>
<p>تغطي هذه الصفحة الموقع فقط. يعمل برنامج RTW على أجهزتك ولا يحتوي على أي قياس عن بُعد. لا يتصل بالإنترنت إلا حين تطلب ذلك — عند التثبيت (مديرو الحزم وGitHub وKiwix وسجل npm) وعند جلب المحتوى من الناشرين المذكورين في التوثيق. القرّاء الذين يستخدمون مكتبتك يتواصلون مع جهازك فقط.</p>
<h2>أسئلة</h2>
<p>افتح بلاغًا على <a href="${issues}">GitHub</a>.</p>`,
  },
}[lang];
---
<Base title={c.title} description={c.description}>
  <section class="section">
    <div class="container prose">
      <h1>{c.title}</h1>
      <p class="muted">{c.updated}</p>
      <Fragment set:html={c.html} />
    </div>
  </section>
</Base>
