---
import { render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import type { Doc } from "../data/docs";
import type { Lang } from "../i18n/config";

interface Props { lang: Lang; doc: Doc }
const { lang, doc } = Astro.props;
const { entry } = doc;
const { Content, headings } = await render(entry);
---
<Docs lang={lang} title={entry.data.title} description={entry.data.description} slug={doc.slug} draft={entry.data.draft} headings={headings}>
  <h1>{entry.data.title}</h1>
  <p class="lead">{entry.data.description}</p>
  <Content />
</Docs>
