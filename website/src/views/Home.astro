---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LibraryMockup from "../components/LibraryMockup.astro";
import NetworkDiagram from "../components/NetworkDiagram.astro";
import PlatformCard from "../components/PlatformCard.astro";
import { platforms } from "../data/platforms";
import { site } from "../config/site";
import { href, type Lang } from "../i18n/config";
import { t } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = (p: string) => href(p, lang);

const copy = {
  en: {
    eyebrow: ["Open Source", "Offline First", "macOS & Android"],
    h1a: "Civilization,", h1b: "Offline.",
    question: "What if the internet disappeared tomorrow?",
    lead: "Preserve, access, and share human knowledge using the devices you already own. No cloud dependency. No internet required to access downloaded content.",
    platformsAria: "Supported platforms", inTesting: "in testing",
    problemEyebrow: "The problem",
    problemH: "The internet is a remarkable invention. It's also a dependency.",
    problemLead: "Most of what we know how to do now lives on remote servers, reached through networks we don't control. That works — until it doesn't.",
    problemNote: "Keeping local copies of essential information is a simple, old idea: libraries have done it for centuries. The internet shouldn't be the only place knowledge lives.",
    problems: [
      ["cap", "Learning stops", "Courses, textbooks and reference sites stop working the moment a connection drops."],
      ["gear", "Repairs stall", "Repair guides and manuals increasingly live only online — out of reach exactly when something breaks."],
      ["docs", "Manuals go missing", "Technical documentation moves, gets paywalled, or disappears when a company or website does."],
      ["people", "Sharing gets hard", "Without connectivity, getting the same information to a group of people is slow and unreliable."],
    ],
    approachEyebrow: "The approach", solutionH: "Keep what matters. Access it anywhere.", solutionLead: "Your library. Your device. No internet required.",
    pillars: [
      ["01", "archive", "Preserve knowledge", "Keep local copies of encyclopedias, books, maps and manuals on a device you control. Nothing depends on a remote server staying online."],
      ["02", "offline", "Access it offline", "Read everything in an ordinary web browser, with no internet connection. Search Wikipedia, open books, browse maps."],
      ["03", "share", "Share it locally", "Nearby phones, laptops and tablets connect over local Wi-Fi and read the same library — no app to install."],
    ],
    howEyebrow: "How it works", howH: "Three steps. Then no connection needed.",
    steps: [
      ["Choose your device", "A Mac, or a 64-bit Android phone or tablet with Termux. Readers only need a web browser, so older phones can still be useful."],
      ["Prepare your library", "While you're online, download the collections you want — Wikipedia, maps, books, manuals — and organise them into sections."],
      ["Go offline", "Start the library. Use it on the device itself, or turn on a hotspot so others nearby can read it too."],
    ],
    readMore: "Read the full explanation",
    platformsEyebrow: "Supported platforms", platformsH: "Start with what you have.",
    platformsLead: "Both platforms run the same open-source server. They're not at the same stage — here's exactly what works today.",
    usesEyebrow: "Use cases", usesH: "Built for more than emergencies.", usesLead: "An old phone can still be useful. So can a library that never needs a signal.",
    uses: [
      ["school", "Offline education", "Reference material for classrooms with limited or expensive connectivity."],
      ["mountain", "Remote communities", "A shared local library where the network is slow, costly or absent."],
      ["archive", "Personal archives", "Your own copy of the material you rely on, under your control."],
      ["bolt", "Infrastructure disruptions", "Outages happen. Useful information shouldn't go down with the network."],
      ["compass", "Off-grid & travel", "Maps, guides and encyclopedias that work in the field, on a single device."],
      ["wifi", "Local knowledge sharing", "One device serves a room — a workshop, a clinic, a community hall."],
    ],
    ossEyebrow: "Open source", ossH: "Knowledge should be accessible. So should the tools that preserve it.",
    ossLead: "RTW is community-driven and built in the open. It stands on proven projects — Kiwix, OpenStreetMap, nginx — instead of reinventing them, and it's meant to be extended.",
    contributeGh: "Contribute on GitHub", waysToHelp: "Ways to help", waysAria: "Ways to contribute",
    contrib: ["Code", "Documentation", "Testing", "Translations", "Collection recommendations", "Hardware compatibility reports"],
    closeH: "Keep knowledge alive.", closeLead: "Build your offline library today. Make it available when it matters.",
    explore: "Explore the Project", closing: "Preserve what we know · Share what we've learned · Keep knowledge alive",
  },
  ar: {
    eyebrow: ["مفتوح المصدر", "يعمل دون اتصال", "macOS وAndroid"],
    h1a: "الحضارة،", h1b: "بلا إنترنت.",
    question: "ماذا لو اختفى الإنترنت غدًا؟",
    lead: "احفظ المعرفة الإنسانية واطّلع عليها وشاركها باستخدام الأجهزة التي تملكها بالفعل. لا اعتماد على السحابة، ولا حاجة إلى الإنترنت للوصول إلى المحتوى الذي نزّلته.",
    platformsAria: "المنصات المدعومة", inTesting: "قيد الاختبار",
    problemEyebrow: "المشكلة",
    problemH: "الإنترنت اختراع مذهل. لكنه أيضًا نقطة اعتماد.",
    problemLead: "معظم ما نعرفه اليوم محفوظ على خوادم بعيدة، نصل إليها عبر شبكات لا نتحكم بها. هذا ينجح — إلى أن يتوقف.",
    problemNote: "الاحتفاظ بنسخ محلية من المعلومات الأساسية فكرة قديمة وبسيطة: هذا ما فعلته المكتبات لقرون. لا ينبغي أن يكون الإنترنت المكان الوحيد الذي تعيش فيه المعرفة.",
    problems: [
      ["cap", "يتوقف التعلّم", "تتوقف المقررات والكتب الدراسية والمواقع المرجعية لحظة انقطاع الاتصال."],
      ["gear", "تتعطل الإصلاحات", "أدلة الإصلاح والكتيّبات صارت تعيش على الإنترنت فقط — بعيدة المنال تمامًا حين يتعطل شيء."],
      ["docs", "تضيع الأدلة", "تنتقل الوثائق التقنية أو تُحجب خلف اشتراك أو تختفي حين تختفي الشركة أو الموقع."],
      ["people", "تصعب المشاركة", "دون اتصال، يصبح إيصال المعلومة نفسها إلى مجموعة من الناس بطيئًا وغير موثوق."],
    ],
    approachEyebrow: "النهج", solutionH: "احتفظ بما يهم، واطّلع عليه في أي مكان.", solutionLead: "مكتبتك. جهازك. دون حاجة إلى الإنترنت.",
    pillars: [
      ["01", "archive", "احفظ المعرفة", "احتفظ بنسخ محلية من الموسوعات والكتب والخرائط والأدلة على جهاز تتحكم به. لا شيء يعتمد على بقاء خادم بعيد متصلًا."],
      ["02", "offline", "اطّلع عليها دون اتصال", "اقرأ كل شيء في متصفح ويب عادي دون اتصال بالإنترنت: ابحث في ويكيبيديا، وافتح الكتب، وتصفّح الخرائط."],
      ["03", "share", "شاركها محليًا", "تتصل الهواتف والحواسيب والأجهزة اللوحية القريبة عبر Wi-Fi المحلية وتقرأ المكتبة نفسها — دون تثبيت أي تطبيق."],
    ],
    howEyebrow: "كيف يعمل", howH: "ثلاث خطوات، ثم لا حاجة إلى الاتصال.",
    steps: [
      ["اختر جهازك", "جهاز Mac، أو هاتف أو جهاز لوحي يعمل بنظام Android ‏64 بت مع Termux. القرّاء يحتاجون إلى متصفح ويب فقط، لذا يمكن للهواتف القديمة أن تبقى مفيدة."],
      ["جهّز مكتبتك", "وأنت متصل بالإنترنت، نزّل المجموعات التي تريدها — ويكيبيديا والخرائط والكتب والأدلة — ونظّمها في أقسام."],
      ["انتقل إلى العمل دون اتصال", "شغّل المكتبة. استخدمها على الجهاز نفسه، أو فعّل نقطة اتصال ليقرأها من حولك أيضًا."],
    ],
    readMore: "اقرأ الشرح الكامل",
    platformsEyebrow: "المنصات المدعومة", platformsH: "ابدأ بما لديك.",
    platformsLead: "تشغّل المنصتان الخادم المفتوح المصدر نفسه، لكنهما ليستا في المرحلة نفسها — وهذا بالضبط ما يعمل اليوم.",
    usesEyebrow: "حالات الاستخدام", usesH: "مصمم لما هو أبعد من الطوارئ.", usesLead: "الهاتف القديم ما زال مفيدًا، وكذلك مكتبة لا تحتاج إلى إشارة أبدًا.",
    uses: [
      ["school", "التعليم دون اتصال", "مواد مرجعية للفصول الدراسية حيث الاتصال محدود أو مكلف."],
      ["mountain", "المجتمعات النائية", "مكتبة محلية مشتركة حيث الشبكة بطيئة أو مكلفة أو غائبة."],
      ["archive", "الأرشيفات الشخصية", "نسختك الخاصة من المواد التي تعتمد عليها، تحت تصرفك."],
      ["bolt", "انقطاع البنية التحتية", "الانقطاعات تحدث، ولا ينبغي أن تسقط المعلومات المفيدة مع الشبكة."],
      ["compass", "خارج الشبكة وفي السفر", "خرائط وأدلة وموسوعات تعمل في الميدان على جهاز واحد."],
      ["wifi", "مشاركة المعرفة محليًا", "جهاز واحد يخدم قاعة كاملة — ورشة أو عيادة أو مركزًا مجتمعيًا."],
    ],
    ossEyebrow: "مفتوح المصدر", ossH: "يجب أن تكون المعرفة متاحة، وكذلك الأدوات التي تحفظها.",
    ossLead: "RTW مشروع مجتمعي يُبنى في العلن. يعتمد على مشاريع مُثبتة — Kiwix وOpenStreetMap وnginx — بدل إعادة اختراعها، وهو مصمم ليُبنى عليه.",
    contributeGh: "ساهم على GitHub", waysToHelp: "طرق المساعدة", waysAria: "طرق المساهمة",
    contrib: ["الشيفرة البرمجية", "التوثيق", "الاختبار", "الترجمة", "اقتراح المجموعات", "تقارير توافق الأجهزة"],
    closeH: "أبقِ المعرفة حيّة.", closeLead: "ابنِ مكتبتك دون اتصال اليوم، لتكون متاحة حين يهم الأمر.",
    explore: "استكشف المشروع", closing: "احفظ ما نعرفه · شارك ما تعلّمناه · أبقِ المعرفة حيّة",
  },
}[lang];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: site.name, alternateName: site.shortName, url: site.url, description: site.description[lang], inLanguage: lang },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: site.name,
    alternateName: site.shortName,
    description: site.description[lang],
    url: site.url,
    ...(site.repo.url ? { codeRepository: site.repo.url } : {}),
    programmingLanguage: ["Shell", "Python", "JavaScript"],
    runtimePlatform: ["macOS", "Android (Termux)"],
    author: { "@type": "Person", name: site.maintainer.name, ...(site.maintainer.url ? { url: site.maintainer.url } : {}) },
  },
];
---
<Base jsonLd={jsonLd}>
  <!-- A. Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow reveal">
          {copy.eyebrow.map((e, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<span>{e}</span></>)}
        </p>
        <h1 class="reveal reveal-2">{copy.h1a}<br /><span class="accent">{copy.h1b}</span></h1>
        <p class="hero-q reveal reveal-3">{copy.question}</p>
        <p class="lead reveal reveal-3">{copy.lead}</p>
        <div class="btn-row reveal reveal-4">
          <a class="btn btn-primary" href={h("/docs/quick-start/")}>{ui.getStarted} <Icon name="arrow" size={16} /></a>
          {site.repo.url && <a class="btn" href={site.repo.url}><Icon name="github" size={18} /> {ui.viewGithub}</a>}
        </div>
        <ul class="platform-pills reveal reveal-4" aria-label={copy.platformsAria}>
          <li><Icon name="apple" size={16} /> macOS</li>
          <li><Icon name="android" size={16} /> Android <span class="muted">· {copy.inTesting}</span></li>
        </ul>
      </div>
      <!-- B. Product visualization -->
      <div class="hero-visual reveal reveal-3">
        <LibraryMockup />
      </div>
    </div>
  </section>

  <!-- C. Problem -->
  <section class="section" aria-labelledby="problem-h">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">{copy.problemEyebrow}</p>
        <h2 id="problem-h">{copy.problemH}</h2>
        <p class="lead">{copy.problemLead}</p>
        <p class="muted">{copy.problemNote}</p>
      </div>
      <div class="grid grid-2 problems">
        {copy.problems.map(([icon, title, text]) => (
          <div class="card">
            <span class="icon-tile"><Icon name={icon} /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- D. Solution -->
  <section class="section" aria-labelledby="solution-h">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">{copy.approachEyebrow}</p>
        <h2 id="solution-h">{copy.solutionH}</h2>
        <p class="lead">{copy.solutionLead}</p>
      </div>
      <div class="grid grid-3">
        {copy.pillars.map(([n, icon, title, text]) => (
          <div class="card pillar hoverable">
            <div class="pillar-top"><span class="icon-tile"><Icon name={icon} /></span><span class="mono num">{n}</span></div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- E. How it works -->
  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{copy.howEyebrow}</p>
        <h2 id="how-h">{copy.howH}</h2>
      </div>
      <ol class="steps">
        {copy.steps.map(([title, text], i) => (
          <li>
            <span class="step-n mono">{i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <div class="diagram-wrap">
        <NetworkDiagram />
      </div>
      <p><a class="text-link" href={h("/how-it-works/")}>{copy.readMore} <Icon name="arrow" size={15} /></a></p>
    </div>
  </section>

  <!-- F. Platforms -->
  <section class="section" aria-labelledby="platforms-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{copy.platformsEyebrow}</p>
        <h2 id="platforms-h">{copy.platformsH}</h2>
        <p class="lead">{copy.platformsLead}</p>
      </div>
      <div class="grid grid-2">
        {platforms.map((p) => <PlatformCard platform={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- G. Use cases -->
  <section class="section" aria-labelledby="uses-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{copy.usesEyebrow}</p>
        <h2 id="uses-h">{copy.usesH}</h2>
        <p class="lead">{copy.usesLead}</p>
      </div>
      <div class="grid grid-3">
        {copy.uses.map(([icon, title, text]) => (
          <div class="use">
            <span class="icon-tile"><Icon name={icon} /></span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- H. Open source -->
  <section class="section" aria-labelledby="oss-h">
    <div class="container oss">
      <div>
        <p class="eyebrow">{copy.ossEyebrow}</p>
        <h2 id="oss-h">{copy.ossH}</h2>
        <p class="lead">{copy.ossLead}</p>
        <div class="btn-row">
          {site.repo.url && <a class="btn btn-primary" href={site.repo.url}><Icon name="github" size={18} /> {copy.contributeGh}</a>}
          <a class="btn" href={h("/contribute/")}>{copy.waysToHelp}</a>
        </div>
      </div>
      <ul class="contrib" aria-label={copy.waysAria}>
        {copy.contrib.map((c) => <li><Icon name="check" size={16} /> {c}</li>)}
      </ul>
    </div>
  </section>

  <!-- I. Closing CTA -->
  <section class="section closing" aria-labelledby="close-h">
    <div class="container center">
      <svg class="close-mark" width="56" height="56" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16 3.5A12.5 12.5 0 0 1 26.83 9.75" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round"/><path d="M16 12.6V5.6M16 19.4v7M19.4 16h7M12.6 16h-7M18.4 13.6l4.95-4.95M13.6 18.4l-4.95 4.95M18.4 18.4l4.95 4.95M13.6 13.6l-4.95-4.95" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="16" cy="16" r="3.4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <h2 id="close-h">{copy.closeH}</h2>
      <p class="lead">{copy.closeLead}</p>
      <div class="btn-row center-row">
        <a class="btn btn-primary" href={h("/docs/quick-start/")}>{ui.getStarted} <Icon name="arrow" size={16} /></a>
        <a class="btn" href={h("/how-it-works/")}>{copy.explore}</a>
      </div>
      <p class="closing-line">{copy.closing}</p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 8vw, 104px) 0 clamp(56px, 8vw, 96px); position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 30%, #000 30%, transparent 75%);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  h1 { margin-bottom: 20px; }
  .accent { color: var(--accent); }
  .hero-q { font-size: clamp(1.15rem, 2vw, 1.4rem); font-weight: 600; margin-bottom: 10px; }
  .hero-copy .lead { max-width: 34em; margin-bottom: 28px; }
  .platform-pills { list-style: none; padding: 0; margin: 26px 0 0; display: flex; gap: 10px; flex-wrap: wrap; }
  .platform-pills li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; font-size: .85rem; background: var(--surface); }

  .split { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 72px); align-items: start; }
  .split .section-head { margin-bottom: 0; position: sticky; top: calc(var(--header-h) + 32px); }
  .problems { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }

  .pillar-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .num { color: var(--subtle); font-size: .8rem; }

  .steps { list-style: none; padding: 0; margin: 0 0 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s; }
  .steps li { padding: 24px; border-top: 2px solid var(--border); position: relative; }
  .steps li:first-child { border-top-color: var(--accent); }
  .step-n { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--accent); color: var(--accent); font-size: .85rem; margin-bottom: 14px; }
  .steps p { color: var(--muted); margin: 0; font-size: .95rem; }
  .diagram-wrap { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(14px, 3vw, 28px); background: var(--surface); margin-bottom: 20px; }
  .text-link { color: var(--accent); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .text-link:hover { text-decoration: underline; }

  .use { display: flex; gap: 16px; padding: 8px 0; }
  .use .icon-tile { flex: none; margin: 0; }
  .use h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .use p { color: var(--muted); margin: 0; font-size: .95rem; }

  .oss { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 72px); align-items: center; }
  .oss .lead { margin-bottom: 28px; }
  .contrib { list-style: none; margin: 0; padding: 8px; display: grid; gap: 2px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .contrib li { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 10px; }
  .contrib li:not(:last-child) { border-bottom: 1px solid var(--border); border-radius: 0; }
  .contrib :global(svg) { color: var(--accent); }

  .closing { text-align: center; }
  .center { text-align: center; }
  .close-mark { color: var(--muted); margin-bottom: 20px; }
  .closing h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .center-row { justify-content: center; margin-top: 28px; }
  .closing-line { margin-top: 40px; font-size: .82rem; color: var(--subtle); }
  @media (prefers-reduced-motion: no-preference) {
    .close-mark { transition: transform 1.4s cubic-bezier(.2, .7, .2, 1); }
    .closing:hover .close-mark { transform: rotate(90deg); }
  }

  @media (max-width: 980px) {
    .hero-grid, .split, .oss { grid-template-columns: minmax(0, 1fr); }
    .split .section-head { position: static; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
