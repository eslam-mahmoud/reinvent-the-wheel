---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import { type Lang } from "../i18n/config";

interface Props { lang: Lang }
const { lang } = Astro.props;
const updated = new Date(site.legalUpdated).toLocaleDateString(lang === "ar" ? "ar" : "en", { year: "numeric", month: "long", day: "numeric" });
const lic = site.license;
const c = {
  en: {
    title: "Terms", description: "Terms for using this website and the information on it.", updated: `Last updated ${updated}`,
    html: `
<h2>The website</h2>
<p>This website describes the Reinvent the Wheel open-source project. It's provided as is, without warranties of any kind. We try to keep it accurate, but things change — check the documentation and repository for the current state.</p>
<h2>The software</h2>
<p>${lic ? `The RTW software is released under the <a href="${lic.url}">${lic.name} license</a>, which governs its use.` : "The RTW source code is public. A license file has not been published in the repository yet; until it is, check the repository before reusing the code."} It is provided as is, without warranty.</p>
<h2>Third-party content</h2>
<p>RTW helps you store and share material from other publishers — Wikipedia, Kiwix, map data, books, apps and more. That material belongs to its publishers and is covered by their licenses and terms. Not everything that's free to download is free to redistribute. You're responsible for respecting those terms when you share content with others.</p>
<h2>Not professional advice</h2>
<p>Health, safety, engineering and survival resources listed on this site are for reference and education. They haven't been professionally reviewed for RTW and don't replace qualified professionals or emergency services.</p>
<h2>Changes</h2>
<p>These terms may be updated; the date above shows the latest revision.</p>`,
  },
  ar: {
    title: "الشروط", description: "شروط استخدام هذا الموقع والمعلومات الواردة فيه.", updated: `آخر تحديث: ${updated}`,
    html: `
<h2>الموقع</h2>
<p>يصف هذا الموقع مشروع Reinvent the Wheel المفتوح المصدر، ويُقدَّم كما هو دون أي ضمانات. نحاول إبقاءه دقيقًا، لكن الأمور تتغير — راجع التوثيق والمستودع لمعرفة الحالة الراهنة.</p>
<h2>البرنامج</h2>
<p>${lic ? `يُنشر برنامج RTW بموجب <a href="${lic.url}">رخصة ${lic.name}</a> التي تحكم استخدامه.` : "الشيفرة المصدرية لـRTW منشورة علنًا، لكن ملف الرخصة لم يُنشر في المستودع بعد؛ وإلى أن يُنشر، راجع المستودع قبل إعادة استخدام الشيفرة."} ويُقدَّم كما هو دون ضمان.</p>
<h2>محتوى الأطراف الأخرى</h2>
<p>يساعدك RTW على تخزين مواد من ناشرين آخرين ومشاركتها — ويكيبيديا وKiwix وبيانات الخرائط والكتب والتطبيقات وغيرها. هذه المواد ملك لناشريها وتخضع لرخصهم وشروطهم. ليس كل ما يُنزَّل مجانًا يجوز إعادة توزيعه. أنت مسؤول عن احترام هذه الشروط حين تشارك المحتوى مع الآخرين.</p>
<h2>ليست مشورة متخصصة</h2>
<p>موارد الصحة والسلامة والهندسة والنجاة المدرجة في هذا الموقع للمرجعية والتعليم. لم يراجعها مختصون لصالح RTW، ولا تغني عن المختصين المؤهلين أو خدمات الطوارئ.</p>
<h2>التغييرات</h2>
<p>قد تُحدَّث هذه الشروط؛ ويبيّن التاريخ أعلاه آخر مراجعة.</p>`,
  },
}[lang];
---
<Base title={c.title} description={c.description}>
  <section class="section">
    <div class="container prose">
      <h1>{c.title}</h1>
      <p class="muted">{c.updated}</p>
      <Fragment set:html={c.html} />
    </div>
  </section>
</Base>
