---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import NetworkDiagram from "../components/NetworkDiagram.astro";
import { href, type Lang } from "../i18n/config";

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = (p: string) => href(p, lang);

// Paragraph strings may contain simple inline HTML (links, <code>, <strong>).
const c = {
  en: {
    title: "How It Works",
    description: "How Reinvent the Wheel stores knowledge on a device, serves it locally and shares it over Wi-Fi without the internet.",
    eyebrow: "How it works",
    h1: "A library that lives on your device.",
    lead: "RTW keeps knowledge in ordinary files on a device you own, and serves it as web pages — to that device and to anyone nearby on the same Wi-Fi. Here's what happens, without the jargon.",
    jumpAria: "On this page",
    toc: [["what", "What is an offline library?"], ["storage", "How content is stored"], ["access", "How local access works"], ["sharing", "Sharing over Wi-Fi"], ["reader-server", "Reader vs. local server"], ["devices", "Supported devices"], ["external", "External storage"], ["limits", "Limitations"], ["backups", "Backups"], ["related", "Kiwix & Internet-in-a-Box"]],
    what: ["What is an offline knowledge library?", "It's a collection of useful material — an encyclopedia, books, maps, manuals, notes — copied onto a device so it can be used without any connection. You download it once, while you're online. After that, reading it never touches the internet."],
    storage: ["How downloaded content is stored", "As plain files in plain folders: one folder per section (Wikipedia, books, notes, maps, downloads, sites). Wikipedia and similar collections come as single compressed <strong>ZIM</strong> files from Kiwix; maps as a single <strong>PMTiles</strong> file; books as PDFs or EPUBs.", "Because they're ordinary files, you can add or back them up with any file manager — nothing is locked inside a proprietary database."],
    access: ["How local access works", "The device runs a small web server (<a href=\"https://nginx.org\">nginx</a>) alongside Kiwix's own server. You open the library in a browser at <code>http://127.0.0.1:8080</code> — an address that always means “this device”. The pages, search and maps all load from local storage."],
    sharing: ["How offline Wi-Fi sharing works", "Wi-Fi is a radio network between nearby devices. The internet is something a router <em>may</em> also provide — but it isn't required for devices on the same network to talk to each other. When a phone joins the host's hotspot and opens the library's address, the host answers directly."],
    rs: ["The difference between a reader and a local server", "A reader", "An app that opens offline content on one device, for one person — like the Kiwix app reading a ZIM file.", "A local server", "One device holds the content and serves it to many. Readers need nothing but a browser. This is what RTW sets up."],
    devicesH: "Supported device architectures",
    devices: ["<strong>macOS</strong> on Apple Silicon or Intel — available from source, tested on Apple Silicon.", "<strong>Android</strong> on 64-bit ARM (arm64-v8a) through Termux — available from source, tested on a Redmi Pad 2 Pro.", "<strong>Readers:</strong> any device with a reasonably modern web browser, including older phones."],
    external: ["Optional external storage", "Large collections can outgrow internal storage, so keeping a library on a USB-C drive is a natural idea. Whether it works depends on the device's USB-C support, the drive's filesystem and Android's storage permissions — Android in particular restricts where apps may write on removable media.", "<strong>Not supported yet.</strong> External storage hasn't been tested on either platform.", "What's known so far."],
    limitsH: "Common operating limitations",
    limits: ["The host has to stay on and awake while others use it.", "Android may stop background apps to save battery — Termux needs “No restrictions”.", "Range is limited to the Wi-Fi network, typically a room or a building.", "Content is a snapshot: it doesn't update until you download a newer copy.", "Browsers only share location with HTTPS pages, so map location on other devices needs a one-time certificate warning."],
    backups: ["The importance of backups", "A library on one device is one dropped phone away from gone. Copy your content folder somewhere else — another drive, another computer, a second device. Some sources change or disappear over time, so your copy may become the only one you can get.", "Backup & Recovery"],
    relatedH: "How RTW relates to Kiwix and Internet-in-a-Box",
    relatedLead: "RTW doesn't replace them — it depends on them and is inspired by them.",
    related: ["<a href=\"https://kiwix.org\">Kiwix</a> creates the ZIM format and the server RTW uses to serve Wikipedia and other collections. RTW runs <code>kiwix-serve</code> unmodified.", "<a href=\"https://internet-in-a-box.org\">Internet-in-a-Box</a> pioneered the “library in a box” idea, typically on a Raspberry Pi with many optional services. RTW is a lighter take aimed at the devices people already own — a Mac or an Android phone, without root.", "Maps come from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> data via <a href=\"https://protomaps.com\">Protomaps</a>, rendered with <a href=\"https://maplibre.org\">MapLibre</a>."],
    relatedNote: "Each project keeps its own license. Content downloaded through these tools carries the license of its original publisher.",
  },
  ar: {
    title: "كيف يعمل",
    description: "كيف يحفظ مشروع «إعادة اختراع العجلة» المعرفة على جهازك، ويقدّمها محليًا، ويشاركها عبر Wi-Fi دون إنترنت.",
    eyebrow: "كيف يعمل",
    h1: "مكتبة تعيش على جهازك.",
    lead: "يحفظ RTW المعرفة في ملفات عادية على جهاز تملكه، ويقدّمها كصفحات ويب — لهذا الجهاز ولكل من حولك على شبكة Wi-Fi نفسها. إليك ما يحدث، دون مصطلحات معقدة.",
    jumpAria: "في هذه الصفحة",
    toc: [["what", "ما المكتبة دون اتصال؟"], ["storage", "كيف يُخزَّن المحتوى"], ["access", "كيف يعمل الوصول المحلي"], ["sharing", "المشاركة عبر Wi-Fi"], ["reader-server", "القارئ مقابل الخادم المحلي"], ["devices", "الأجهزة المدعومة"], ["external", "التخزين الخارجي"], ["limits", "القيود"], ["backups", "النسخ الاحتياطي"], ["related", "Kiwix وInternet-in-a-Box"]],
    what: ["ما مكتبة المعرفة دون اتصال؟", "هي مجموعة من المواد المفيدة — موسوعة وكتب وخرائط وأدلة وملاحظات — منسوخة إلى جهاز لتُستخدم دون أي اتصال. تنزّلها مرة واحدة وأنت متصل، وبعدها لا تحتاج القراءة إلى الإنترنت أبدًا."],
    storage: ["كيف يُخزَّن المحتوى المنزَّل", "كملفات عادية في مجلدات عادية: مجلد لكل قسم (ويكيبيديا، الكتب، الملاحظات، الخرائط، التنزيلات، المواقع). تأتي ويكيبيديا والمجموعات المشابهة كملف <strong>ZIM</strong> مضغوط واحد من Kiwix، والخرائط كملف <strong>PMTiles</strong> واحد، والكتب كملفات PDF أو EPUB.", "ولأنها ملفات عادية، يمكنك إضافتها أو نسخها احتياطيًا بأي مدير ملفات — لا شيء محبوس داخل قاعدة بيانات مغلقة."],
    access: ["كيف يعمل الوصول المحلي", "يشغّل الجهاز خادم ويب صغيرًا (<a href=\"https://nginx.org\">nginx</a>) إلى جانب خادم Kiwix. تفتح المكتبة في المتصفح على العنوان <code>http://127.0.0.1:8080</code> — وهو عنوان يعني دائمًا «هذا الجهاز». الصفحات والبحث والخرائط كلها تُحمَّل من التخزين المحلي."],
    sharing: ["كيف تعمل المشاركة عبر Wi-Fi دون إنترنت", "شبكة Wi-Fi شبكة لاسلكية بين أجهزة متقاربة. أما الإنترنت فشيء <em>قد</em> يوفّره الراوتر أيضًا — لكنه ليس ضروريًا كي تتحدث الأجهزة المتصلة بالشبكة نفسها مع بعضها. حين ينضم هاتف إلى نقطة اتصال الجهاز المضيف ويفتح عنوان المكتبة، يجيبه المضيف مباشرة."],
    rs: ["الفرق بين القارئ والخادم المحلي", "القارئ", "تطبيق يفتح المحتوى دون اتصال على جهاز واحد لشخص واحد — مثل تطبيق Kiwix حين يقرأ ملف ZIM.", "الخادم المحلي", "جهاز واحد يحمل المحتوى ويقدّمه للكثيرين، ولا يحتاج القرّاء إلا إلى متصفح. وهذا ما يجهّزه RTW."],
    devicesH: "معماريات الأجهزة المدعومة",
    devices: ["<strong>macOS</strong> على Apple Silicon أو Intel — متاح من الشيفرة المصدرية، واختُبر على Apple Silicon.", "<strong>Android</strong> على ARM ‏64 بت ‏(arm64-v8a) عبر Termux — متاح من الشيفرة المصدرية، واختُبر على Redmi Pad 2 Pro.", "<strong>القرّاء:</strong> أي جهاز بمتصفح ويب حديث نسبيًا، بما في ذلك الهواتف القديمة."],
    external: ["التخزين الخارجي الاختياري", "قد تتجاوز المجموعات الكبيرة سعة التخزين الداخلي، فتبدو فكرة حفظ المكتبة على قرص USB-C طبيعية. لكن نجاحها يعتمد على دعم الجهاز لمنفذ USB-C، ونظام ملفات القرص، وأذونات التخزين في Android — إذ يقيّد Android تحديدًا الأماكن التي يمكن للتطبيقات الكتابة فيها على الوسائط القابلة للإزالة.", "<strong>غير مدعوم بعد.</strong> لم يُختبر التخزين الخارجي على أي من المنصتين.", "ما نعرفه حتى الآن."],
    limitsH: "قيود تشغيلية شائعة",
    limits: ["يجب أن يبقى الجهاز المضيف يعمل ومستيقظًا ما دام الآخرون يستخدمونه.", "قد يوقف Android التطبيقات في الخلفية لتوفير البطارية — يحتاج Termux إلى إعداد «بلا قيود».", "المدى محدود بشبكة Wi-Fi، عادةً غرفة أو مبنى.", "المحتوى لقطة ثابتة: لا يتحدّث حتى تنزّل نسخة أحدث.", "لا تشارك المتصفحات الموقع إلا مع صفحات HTTPS، لذا يتطلب عرض الموقع على الخريطة من أجهزة أخرى قبول تحذير الشهادة مرة واحدة."],
    backups: ["أهمية النسخ الاحتياطي", "المكتبة على جهاز واحد قد تضيع بسقوط هاتف واحد. انسخ مجلد المحتوى إلى مكان آخر — قرص آخر أو حاسوب آخر أو جهاز ثانٍ. بعض المصادر تتغير أو تختفي مع الوقت، فقد تصبح نسختك هي الوحيدة المتاحة لك.", "النسخ الاحتياطي والاستعادة"],
    relatedH: "علاقة RTW بـKiwix وInternet-in-a-Box",
    relatedLead: "لا يحلّ RTW محلّهما — بل يعتمد عليهما ويستلهم منهما.",
    related: ["أنشأ <a href=\"https://kiwix.org\">Kiwix</a> صيغة ZIM والخادم الذي يستخدمه RTW لتقديم ويكيبيديا والمجموعات الأخرى. يشغّل RTW الأداة <code>kiwix-serve</code> دون تعديل.", "رسّخ <a href=\"https://internet-in-a-box.org\">Internet-in-a-Box</a> فكرة «المكتبة في صندوق»، غالبًا على Raspberry Pi مع خدمات اختيارية كثيرة. أما RTW فنسخة أخفّ تستهدف الأجهزة التي يملكها الناس أصلًا — Mac أو هاتف Android، دون صلاحيات root.", "تأتي الخرائط من بيانات <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> عبر <a href=\"https://protomaps.com\">Protomaps</a>، وتُعرض بواسطة <a href=\"https://maplibre.org\">MapLibre</a>."],
    relatedNote: "يحتفظ كل مشروع برخصته الخاصة، ويحمل المحتوى المنزَّل عبر هذه الأدوات رخصة ناشره الأصلي.",
  },
}[lang];
---
<Base title={c.title} description={c.description}>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <nav class="jump" aria-label={c.jumpAria}>
        {c.toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ArchitectureDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container prose-grid">
      <article id="what">
        <h2>{c.what[0]}</h2>
        <p>{c.what[1]}</p>
      </article>

      <article id="storage">
        <h2>{c.storage[0]}</h2>
        <p set:html={c.storage[1]} />
        <p>{c.storage[2]}</p>
      </article>

      <article id="access">
        <h2>{c.access[0]}</h2>
        <p set:html={c.access[1]} />
      </article>

      <article id="sharing">
        <h2>{c.sharing[0]}</h2>
        <p set:html={c.sharing[1]} />
        <div class="diagram"><NetworkDiagram compact /></div>
      </article>

      <article id="reader-server">
        <h2>{c.rs[0]}</h2>
        <div class="grid grid-2 compare">
          <div class="card">
            <span class="icon-tile"><Icon name="book" /></span>
            <h3>{c.rs[1]}</h3>
            <p>{c.rs[2]}</p>
          </div>
          <div class="card">
            <span class="icon-tile"><Icon name="server" /></span>
            <h3>{c.rs[3]}</h3>
            <p>{c.rs[4]}</p>
          </div>
        </div>
      </article>

      <article id="devices">
        <h2>{c.devicesH}</h2>
        <ul class="check-list">
          {c.devices.map((d) => <li><Icon name="check" size={16} /><span set:html={d} /></li>)}
        </ul>
      </article>

      <article id="external">
        <h2>{c.external[0]}</h2>
        <p>{c.external[1]}</p>
        <p class="note"><span set:html={c.external[2]} /> <a href={h("/docs/external-usb-storage/")}>{c.external[3]}</a></p>
      </article>

      <article id="limits">
        <h2>{c.limitsH}</h2>
        <ul class="check-list">
          {c.limits.map((l) => <li><Icon name="dot" size={16} /><span>{l}</span></li>)}
        </ul>
      </article>

      <article id="backups">
        <h2>{c.backups[0]}</h2>
        <p>{c.backups[1]} <a href={h("/docs/backup-and-recovery/")}>{c.backups[2]}</a>.</p>
      </article>

      <article id="related">
        <h2>{c.relatedH}</h2>
        <p>{c.relatedLead}</p>
        <ul class="check-list">
          {c.related.map((r) => <li><Icon name="check" size={16} /><span set:html={r} /></li>)}
        </ul>
        <p class="muted">{c.relatedNote}</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-bottom: 32px; }
  .page-hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: 16ch; }
  .page-hero .lead { max-width: 60ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .jump a { font-size: .82rem; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; text-decoration: none; color: var(--muted); }
  .jump a:hover { color: var(--text); border-color: var(--border-strong); }
  .prose-grid { display: grid; gap: 56px; max-width: 820px; }
  .prose-grid article { scroll-margin-top: calc(var(--header-h) + 16px); }
  .prose-grid article h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); }
  .prose-grid article > p { color: color-mix(in srgb, var(--text) 86%, var(--muted)); }
  .prose-grid :global(a) { color: var(--accent); }
  .diagram { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px; background: var(--surface); margin-top: 20px; }
  .compare { margin-top: 8px; }
</style>
