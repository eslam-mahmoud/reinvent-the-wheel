# Generated by install.sh from nginx.conf.in — edit the template, not this file.
# @STATE@ = runtime dir (conf/logs/run), @WEB@ = pages, @CONTENT@ = content dir.

worker_processes 2;
pid @STATE@/run/nginx.pid;
error_log @STATE@/logs/nginx-error.log warn;

events {
    worker_connections 512;
}

http {
    include @MIME_TYPES@;
    default_type application/octet-stream;
    charset utf-8;

    sendfile on;
    keepalive_timeout 30;
    access_log @STATE@/logs/nginx-access.log;

    # Non-root nginx needs writable temp dirs.
    client_body_temp_path @STATE@/run/client_body;
    proxy_temp_path       @STATE@/run/proxy;
    fastcgi_temp_path     @STATE@/run/fastcgi;
    uwsgi_temp_path       @STATE@/run/uwsgi;
    scgi_temp_path        @STATE@/run/scgi;

    gzip on;
    gzip_types text/css application/javascript application/json text/plain text/markdown image/svg+xml;

    server {
        listen @PORT@;
        # HTTPS (self-signed) so other phones may use GPS on the map page.
        listen @HTTPS_PORT@ ssl;
        ssl_certificate     @STATE@/conf/tls.crt;
        ssl_certificate_key @STATE@/conf/tls.key;
        server_name _;

        # Home page, app pages (books/notes/maps viewers) and vendored JS.
        root @WEB@;
        index index.html;

        location / {
            try_files $uri $uri/ =404;
            # Revalidate app pages/scripts so updates show up right away.
            add_header Cache-Control "no-cache";
        }

        # Per-install settings for the pages (e.g. HTTPS port).
        location = /config.js {
            alias @STATE@/conf/config.js;
        }

        location /vendor/ {
            expires 30d;
        }

        # Wikipedia (kiwix-serve).
        location /wiki/ {
            proxy_pass http://127.0.0.1:@KIWIX_PORT@;
            proxy_set_header Host $host;
            proxy_read_timeout 120s;
        }

        # Raw content. JSON directory listings feed the books/notes/maps pages.
        location /data/books/ {
            alias @CONTENT@/books/;
            autoindex on;
            autoindex_format json;
        }

        location /data/notes/ {
            alias @CONTENT@/notes/;
            autoindex on;
            autoindex_format json;
            types { }
            default_type "text/plain";
        }

        location /data/maps/ {
            alias @CONTENT@/maps/;
            autoindex on;
            autoindex_format json;
            types { }
            default_type application/octet-stream;
            add_header Access-Control-Allow-Origin *;
        }

        # Files to download: APKs, PDFs, anything.
        location /data/downloads/ {
            alias @CONTENT@/downloads/;
            autoindex on;
            autoindex_format json;
            types {
                application/vnd.android.package-archive apk;
                application/pdf pdf;
                application/epub+zip epub;
                application/zip zip;
            }
            default_type application/octet-stream;
        }

        # Admin: upload/manage content. Password-protected; the API listens on
        # 127.0.0.1 only, so this is the only way in.
        location /admin/ {
            auth_basic "RTW admin";
            auth_basic_user_file @STATE@/conf/htpasswd;
            try_files $uri $uri/ =404;
        }

        location /admin/api/ {
            auth_basic "RTW admin";
            auth_basic_user_file @STATE@/conf/htpasswd;
            proxy_pass http://127.0.0.1:@ADMIN_PORT@;
            client_max_body_size 0;          # no limit: ZIM/map files are GBs
            proxy_request_buffering off;     # stream to disk, don't buffer
            proxy_http_version 1.1;          # needed to stream chunked bodies
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Read-only library stats (file counts, sizes, free space) for the home page.
        location = /api/stats {
            proxy_pass http://127.0.0.1:@ADMIN_PORT@/admin/api/summary;
            proxy_method GET;
            proxy_pass_request_body off;
            add_header Cache-Control "no-store";
        }

        # Read-only full-text search across notes (names and text).
        location = /api/notes-search {
            proxy_pass http://127.0.0.1:@ADMIN_PORT@/admin/api/notes-search$is_args$args;
            proxy_method GET;
            proxy_pass_request_body off;
            add_header Cache-Control "no-store";
        }

        location /data/www/ {
            alias @CONTENT@/www/;
            autoindex on;
            autoindex_format json;
        }

        # Static HTML sites: drop folders into RTW/www on the tablet.
        location /sites/ {
            alias @CONTENT@/www/;
            autoindex on;
            index index.html;
        }
    }
}
