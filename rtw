#!/usr/bin/env bash
# rtw — one command to set up, run and manage the offline library.
# Works the same on the Mac and on the Android tablet (Termux).
#
#   rtw setup            install dependencies + write config (first time)
#   rtw start | stop | restart | status
#   rtw address          show the addresses other devices can open (they change with the network)
#   rtw passwd           set or reset the admin password (forgot it? run this)
#   rtw fetch [pack]     install knowledge packs (wizard) or one download — see rtw help
#   rtw update           get the latest version from GitHub and re-install
#   rtw push [app]       Mac only: copy app (+ content) to the tablet over USB
#   rtw logs [name]      follow a log: nginx-error | admin | kiwix
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$SELF")"
export RTW_ENV="$ROOT/state/conf/rtw.env"
# Downloaded tools (kiwix on Mac, pmtiles on Termux) live in state/bin.
export PATH="$ROOT/state/bin:$PATH"

is_termux() { [[ "${PREFIX:-}" == */com.termux/* ]]; }

# Called as rtw-start / rtw-stop / … (tablet shortcuts) → map to subcommand.
as="${RTW_AS:-$(basename "$0")}"
if [[ "$as" == rtw-* ]]; then
    cmd="${as#rtw-}"
else
    cmd="${1:-help}"; shift || true
fi

usage() {
    local me="rtw"; is_termux || me="./rtw"
    local content="(not set up yet — run: $me setup)"
    if [ -f "$RTW_ENV" ]; then content="$(. "$RTW_ENV"; echo "$CONTENT")"; fi
    cat <<EOF
rtw — Reinvent the Wheel · إعادة اختراع العجلة
Your offline library: Wikipedia, books, notes, maps and apps, shared over Wi-Fi.

Usage: $me <command>

Run the library
  start              start the library and show its addresses
  stop               stop it
  restart            restart (e.g. after adding a Wikipedia .zim file)
  status             what's running, content sizes and addresses
  address            the addresses other devices can open right now
                     (they change when you switch Wi-Fi or turn the hotspot on)
  logs [name]        follow a log: nginx-error (default) | admin | kiwix

Content (knowledge packs: packages/catalog.json)
  fetch              pick packs to install (nothing is installed unless you choose it)
  fetch list         every pack and item, with sizes and what's installed
  fetch status       the same, checked against the files on disk
  fetch group <id>   install one pack, e.g. food-agriculture
  fetch missing      retry anything selected before that isn't on disk yet
  fetch all          install every pack, no questions (for scripts)
  fetch <name>       one download: wikipedia | maps | osmand | bitchat | vendor
  push [app]         Mac only: copy the app and all content to a tablet over USB

Setup and admin
  setup              install dependencies and write config (first time)
  passwd             set or reset the admin password (forgot it? run this)
  update             get the latest version from GitHub and re-install
  help               show this help

Examples
  $me start
  $me address
  $me fetch group islamic-essentials
  ZIM_PATTERN=wikipedia_en_all_nopic $me fetch wikipedia

Content folder: $content
Admin page:     http://127.0.0.1:8080/admin/  (user: admin)
Docs:           https://reinvent-the-wheel.com/en/docs/
EOF
}

need_setup() {
    [ -f "$RTW_ENV" ] || { echo "Not set up yet. Run: rtw setup" >&2; exit 1; }
}

setup_mac() {
    command -v brew >/dev/null || { echo "Install Homebrew first: https://brew.sh" >&2; exit 1; }
    command -v nginx >/dev/null || brew install nginx
    if ! command -v kiwix-serve >/dev/null; then
        echo "Downloading kiwix-tools (Wikipedia server) for macOS…"
        mkdir -p "$ROOT/state/bin"
        local arch; arch=$([ "$(uname -m)" = arm64 ] && echo arm64 || echo x86_64)
        curl -fsSL "https://download.kiwix.org/release/kiwix-tools/kiwix-tools_macos-$arch.tar.gz" \
            | tar xz -C "$ROOT/state/bin" --strip-components=1
    fi
    [ -d "$ROOT/web/vendor/maplibre" ] || bash "$ROOT/scripts/fetch-vendor.sh"
    ROOT="$ROOT" CONTENT="$ROOT/content" \
        MIME_TYPES="$(brew --prefix)/etc/nginx/mime.types" \
        bash "$ROOT/server/configure.sh"
}

case "$cmd" in
    setup)
        if is_termux; then
            bash "$ROOT/server/install-termux.sh"
        else
            setup_mac
            echo; echo "Ready. Start with: ./rtw start"
        fi
        ;;
    start)   need_setup; bash "$ROOT/server/start.sh" ;;
    stop)    need_setup; bash "$ROOT/server/stop.sh" ;;
    restart) need_setup; bash "$ROOT/server/stop.sh"; sleep 1; bash "$ROOT/server/start.sh" ;;
    status)  need_setup; bash "$ROOT/server/status.sh" ;;
    address|ip) need_setup; bash "$ROOT/server/address.sh" ;;
    passwd|reset-password)
        need_setup
        python3 "$ROOT/server/passwd.py" "$@"
        ;;
    fetch)
        # Content goes where the server reads it (tablet: /sdcard/RTW).
        if [ -f "$RTW_ENV" ]; then set -a; source "$RTW_ENV"; set +a; fi
        what="${1:-}"
        packs=(python3 "$ROOT/scripts/packs.py")
        case "$what" in
            vendor) bash "$ROOT/scripts/fetch-vendor.sh" ;;
            wikipedia|maps|osmand|bitchat) bash "$ROOT/scripts/fetch-$what.sh" ;;
            # Everything in packages/catalog.json, no questions (for scripts).
            all) bash "$ROOT/scripts/fetch-vendor.sh"; "${packs[@]}" install --all --yes ;;
            ""|wizard) "${packs[@]}" wizard ;;
            list|status|missing) "${packs[@]}" "$what" ;;
            group) "${packs[@]}" group "${2:-}" "${@:3}" ;;
            install) shift; "${packs[@]}" install "$@" ;;
            --*) "${packs[@]}" install "$@" ;;
            *) echo "usage: rtw fetch [list|status|missing|group <id>|all|wikipedia|maps|osmand|bitchat|vendor]  (see: rtw help)" >&2; exit 1 ;;
        esac
        ;;
    update)
        [ -d "$ROOT/.git" ] || { echo "Not a git install (copied over USB) — use 'rtw push' from the Mac instead." >&2; exit 1; }
        git -C "$ROOT" pull --ff-only
        if is_termux; then bash "$ROOT/server/install-termux.sh"; fi
        [ -f "$RTW_ENV" ] && { bash "$ROOT/server/stop.sh"; sleep 1; bash "$ROOT/server/start.sh"; }
        ;;
    push)    bash "$ROOT/scripts/push-to-tablet.sh" "$@" ;;
    logs)    need_setup; tail -n 50 -f "$ROOT/state/logs/${1:-nginx-error}.log" ;;
    help|-h|--help) usage ;;
    *) echo "Unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac
